#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$(uname -s)" = Linux ] && [ -n "${DISPLAY:-}" ]; then
    : "${QT_QPA_PLATFORM:=xcb}"
    : "${QT_QPA_PLATFORMTHEME:=gtk3}"
    export QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME
fi
exec "$project_dir/.venv/bin/python" "$project_dir/editor.py" "$@"
